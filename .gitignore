# Зависимости тулинга (jsdom, puppeteer-core) — в боевую выкладку не попадают:
# артефакт Pages собирается из allowlist в tools/build-release.cjs, а не копированием дерева.
node_modules/

# Боевой артефакт: собирается локально/в Actions, в git не живёт (иначе два источника правды).
_site/

# Скриншоты .visual-check.cjs, если запускать её с каталогом внутри репозитория
# (по умолчанию она пишет в os.tmpdir()/neon-shots).
--shots/
shots/

# Логи и мусор ОС/редактора.
*.log
.DS_Store
Thumbs.db
